{
    "name": "captchafox/captchafox-php",
    "description": "Verifies CaptchaFox tokens with siteverify.",
    "type": "library",
    "keywords": ["captcha", "captchafox", "siteverify"],
    "homepage": "https://captchafox.com",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Scoria Labs GmbH",
            "homepage": "https://captchafox.com"
        }
    ],
    "support": {
        "issues": "https://github.com/CaptchaFox/captchafox-php/issues",
        "source": "https://github.com/CaptchaFox/captchafox-php"
    },
    "require": {
        "php": "^8.3",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "CaptchaFox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CaptchaFox\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-live": "phpunit --group live"
    },
    "config": {
        "sort-packages": true
    }
}
